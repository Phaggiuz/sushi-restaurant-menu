@page "/client"

@using System.Globalization
@using sushi_restaurant_project.Shared.Models
@using sushi_restaurant_project.Shared.Services
@using sushi_restaurant_project.Shared.Components
@inject IPlateService PlateService
@inject OrderState OrderState
@inject NavigationManager NavigationManager

<div class="client-page @(isOrderOpen ? "client-page--order-open" : string.Empty)">

    <header class="customer-header">
        <div class="customer-header__container">

            <div class="customer-header__brand"
                 aria-label="Umi Omakase & Sushi Bar">

                <span class="customer-header__logo">
                    Umi
                </span>

                <span class="customer-header__subtitle">
                    Omakase &amp; Sushi Bar
                </span>
            </div>

            <button class="customer-header__order-button"
                    type="button"
                    aria-label="Visualizza ordine"
                    aria-expanded="@isOrderOpen"
                    aria-controls="order-drawer"
                    @onclick="OpenOrder">

                <svg class="customer-header__order-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">

                    <path d="M5.5 7.5h13l-1 12h-11l-1-12Z" />
                    <path d="M9 8V6a3 3 0 0 1 6 0v2" />
                    <path d="M9 12h6" />
                </svg>

                <span>Ordine</span>

                @if (OrderItemCount > 0)
                {
                    <span class="customer-header__order-count"
                          aria-label="@($"{OrderItemCount} elementi nell'ordine")">

                        @OrderItemCount
                    </span>
                }
            </button>

        </div>
    </header>

    @if (isOrderOpen)
    {
        <div class="order-overlay"
             @onclick="CloseOrder">

            <aside id="order-drawer"
                   class="order-drawer"
                   role="dialog"
                   aria-modal="true"
                   aria-labelledby="order-drawer-title"
                   @onclick:stopPropagation="true">

                <header class="order-drawer__header">

                    <h2 id="order-drawer-title"
                        class="order-drawer__title">

                        Il Tuo Ordine
                    </h2>

                    <button class="order-drawer__close-button"
                            type="button"
                            aria-label="Chiudi ordine"
                            @onclick="CloseOrder">

                        <span aria-hidden="true">×</span>
                    </button>

                </header>

                <div class="order-drawer__configuration">

                    <label class="order-drawer__ayce-option">

                        <span class="order-drawer__ayce-content">

                            <span class="order-drawer__ayce-title">
                                All You Can Eat
                            </span>

                            <span class="order-drawer__ayce-description">
                                14,90 € a persona. I prezzi dei singoli piatti non
                                vengono conteggiati.
                            </span>

                        </span>

                        <input class="order-drawer__ayce-input"
                               type="checkbox"
                               checked="@isAllYouCanEat"
                               @onchange="OnAllYouCanEatChanged" />

                        <span class="order-drawer__ayce-switch"
                              aria-hidden="true">
                        </span>

                    </label>

                </div>

                <div class="order-drawer__content">

                    @if (orderItems.Count == 0)
                    {
                        <div class="order-drawer__empty">
                            Nessun Ordine
                        </div>
                    }
                    else
                    {
                        <div class="order-drawer__items">

                            @foreach (var item in orderItems)
                            {
                                <article class="order-item"
                                         @key="item.Plate.Id">

                                    <img class="order-item__image"
                                         src="@GetPlateImageUrl(item.Plate.UrlImage)"
                                         alt="@item.Plate.Name" />

                                    <div class="order-item__details">

                                        <h3 class="order-item__name">
                                            @item.Plate.Name
                                        </h3>

                                        <span class="order-item__price">
                                            @FormatPrice(item.Plate.Price)
                                        </span>

                                    </div>

                                    <div class="order-item__quantity-controls">

                                        <button class="order-item__quantity-button"
                                                type="button"
                                                aria-label="@($"Diminuisci la quantità di {item.Plate.Name}")"
                                                @onclick="() => DecreaseQuantity(item)">

                                            <span aria-hidden="true">−</span>
                                        </button>

                                        <span class="order-item__quantity"
                                              aria-label="@($"Quantità: {item.Quantity}")">

                                            @item.Quantity
                                        </span>

                                        <button class="order-item__quantity-button"
                                                type="button"
                                                aria-label="@($"Aumenta la quantità di {item.Plate.Name}")"
                                                @onclick="() => IncreaseQuantity(item)">

                                            <span aria-hidden="true">+</span>
                                        </button>

                                    </div>

                                </article>
                            }

                        </div>
                    }

                </div>

                <footer class="order-drawer__summary">

                    @if (isAllYouCanEat)
                    {
                        <div class="order-drawer__summary-row">

                            <span>
                                @AllYouCanEatSummaryLabel
                            </span>

                            <span>
                                @FormatPrice(OrderAllYouCanEatAmount)
                            </span>

                        </div>
                    }
                    else
                    {
                        <div class="order-drawer__summary-row">

                            <span>Piatti</span>

                            <span>
                                @FormatPrice(OrderItemsSubtotal)
                            </span>

                        </div>
                    }

                    <div class="order-drawer__summary-row">

                        <span>
                            @CoverSummaryLabel
                        </span>

                        <span>
                            @FormatPrice(OrderCoverAmount)
                        </span>

                    </div>


                    <div class="order-drawer__summary-divider"></div>

                    <div class="order-drawer__summary-row order-drawer__summary-row--total">

                        <strong>Totale</strong>

                        <strong>
                            @FormatPrice(OrderTotal)
                        </strong>

                    </div>

                    <button class="order-drawer__place-order-button"
                            type="button"
                            disabled="@(!CanPlaceOrder)"
                            title="@PlaceOrderButtonTitle"
                            @onclick="PlaceOrder">

                        Ordina
                    </button>

                    <p class="order-drawer__summary-note">
                        L'ordine verrà inviato direttamente alla cucina.
                    </p>

                </footer>

            </aside>

        </div>
    }

    <section class="customer-hero">
        <img class="customer-hero__image"
             src="_content/sushi-restaurant-project.Shared/image/sushi-hero.png"
             alt="Selezione di sushi preparata dal ristorante" />
    </section>

    <nav class="category-navigation"
         aria-label="Categorie del menu">

        <div class="category-navigation__container">

            <button type="button"
                    class="@GetCategoryClass(AllCategory)"
                    aria-pressed="@IsCategorySelected(AllCategory)"
                    @onclick="() => SelectCategory(AllCategory)">

                All
            </button>

            @foreach (var category in Categories)
            {
                <button type="button"
                        class="@GetCategoryClass(category)"
                        aria-pressed="@IsCategorySelected(category)"
                        @onclick="() => SelectCategory(category)">

                    @category
                </button>
            }

        </div>
    </nav>

    <main class="menu-section">

        @if (isLoading)
        {
            <div class="menu-section__message">
                Caricamento menu...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="menu-section__message menu-section__message--error">
                @errorMessage
            </div>
        }
        else if (!FilteredPlates.Any())
        {
            <div class="menu-section__message">
                Nessun piatto disponibile per la categoria selezionata.
            </div>
        }
        else
        {
            <div class="plates-grid">

                @foreach (var plate in FilteredPlates)
                {
                    <article class="plate-card @(IsPlateFlipped(plate.Id)
                                                            ? "plate-card--flipped"
                                                            : string.Empty)"
                             @key="plate.Id">

                        <div class="plate-card__inner">

                            @* FRONTE DELLA CARD *@
                            <div class="plate-card__face plate-card__front">

                                <div class="plate-card__image-container">

                                    <img class="plate-card__image"
                                         src="@GetPlateImageUrl(plate.UrlImage)"
                                         alt="@plate.Name"
                                         loading="lazy" />

                                    @if (plate.IsFrozen)
                                    {
                                        <span class="plate-card__frozen-badge">
                                            Surgelato
                                        </span>
                                    }

                                    <button class="plate-card__info-button"
                                            type="button"
                                            aria-label="@($"Mostra maggiori informazioni su {plate.Name}")"
                                            title="Maggiori informazioni"
                                            @onclick="@(() => ShowPlateDetails(plate.Id))"
                                            @onclick:stopPropagation="true">

                                        <span aria-hidden="true">i</span>
                                    </button>

                                </div>

                                <div class="plate-card__content">

                                    <div class="plate-card__header">

                                        <div class="plate-card__title-container">

                                            <span class="plate-card__category">
                                                @plate.Category
                                            </span>

                                            <h2 class="plate-card__name">
                                                @plate.Name
                                            </h2>

                                        </div>

                                        <div class="plate-card__price">
                                            @FormatPrice(plate.Price)
                                        </div>

                                    </div>

                                    <p class="plate-card__description">
                                        @plate.Description
                                    </p>

                                    <div class="plate-card__allergens">

                                        <span class="plate-card__allergens-title">
                                            Allergeni
                                        </span>

                                        @if (plate.Allergens?.Any() == true)
                                        {
                                            <div class="plate-card__allergens-list">

                                                @foreach (var allergen in plate.Allergens)
                                                {
                                                    <span class="plate-card__allergen">
                                                        @allergen
                                                    </span>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="plate-card__allergens-empty">
                                                Nessun allergene dichiarato
                                            </span>
                                        }

                                    </div>

                                    <button class="plate-card__add-button"
                                            type="button"
                                            aria-label="@($"Aggiungi {plate.Name} all'ordine")"
                                            @onclick="@(() => AddToOrder(plate))">

                                        Aggiungi
                                    </button>

                                </div>

                            </div>

                            @* RETRO DELLA CARD *@
                            <button class="plate-card__face plate-card__back"
                                    type="button"
                                    aria-label="@($"Torna alle informazioni principali di {plate.Name}")"
                                    @onclick="@(() => HidePlateDetails(plate.Id))">

                                <span class="plate-card__back-category">
                                    @plate.Category
                                </span>

                                <span class="plate-card__back-name">
                                    @plate.Name
                                </span>

                                <span class="plate-card__back-divider"
                                      aria-hidden="true">
                                </span>

                                <span class="plate-card__detailed-description">
                                    @if (string.IsNullOrWhiteSpace(plate.DetailedDescription))
                                    {
                                        @plate.Description
                                    }
                                    else
                                    {
                                        @plate.DetailedDescription
                                    }
                                </span>

                                <span class="plate-card__back-hint">
                                    Clicca sulla card per tornare al piatto
                                </span>

                            </button>

                        </div>

                    </article>
                }
            </div>
        }

    </main>

    <CustomerFooter />
</div>

@code {
    private const string AllCategory = "All";

    // Dati del menu caricati tramite PlateService.
    // La lista completa viene mantenuta in memoria e filtrata lato componente
    // in base alla categoria selezionata dall'utente.
    private List<Plate> plates = [];

    private string selectedCategory = AllCategory;
    private bool isLoading = true;
    private string? errorMessage;

    // Contiene gli ID dei piatti la cui card è attualmente visualizzata sul retro.
    // L'uso di un HashSet consente di gestire indipendentemente il flip di ogni card.
    private readonly HashSet<int> flippedPlateIds = [];

    // Rappresenta gli articoli presenti nel carrello visualizzato nel drawer.
    private List<OrderItem> orderItems = [];

    private bool isOrderOpen;
    private bool isAllYouCanEat;
    private bool shouldRedirectToHome;

    /// <summary>
    /// Verifica che l'utente abbia completato la configurazione iniziale
    /// del tavolo prima di poter utilizzare il menu.
    /// </summary>
    private bool HasValidReservation
    {
        get
        {
            var order = OrderState.Order;

            return order.TableNumber is int tableNumber
                && tableNumber is >= 1 and <= 99
                && order.PeopleCount is int peopleCount
                && peopleCount is >= 1 and <= 99;
        }
    }

    // Tariffe attualmente definite lato client.
    // Potranno essere sostituite in futuro da valori provenienti da un servizio.
    private const decimal CoverChargePerPerson = 2.00m;
    private const decimal AllYouCanEatPricePerPerson = 14.90m;



    /// <summary>
    /// Verifica se la card del piatto specificato è attualmente visualizzata sul retro.
    /// </summary>
    private bool IsPlateFlipped(int plateId)
    {
        return flippedPlateIds.Contains(plateId);
    }

    /// <summary>
    /// Numero complessivo di piatti presenti nell'ordine.
    /// Tiene conto delle quantità e non solamente del numero di righe.
    /// </summary>
    private int OrderItemCount =>
        orderItems.Sum(item => item.Quantity);

    /// <summary>
    /// Numero di persone configurato nella Home.
    /// Viene utilizzato per il calcolo del coperto e della modalità AYCE.
    /// </summary>
    private int PeopleCount =>
        OrderState.Order.PeopleCount ?? 0;

    /// <summary>
    /// Totale dei prezzi dei singoli piatti presenti nell'ordine.
    /// Questo valore viene comunque mantenuto nell'OrderState anche quando
    /// è attiva la modalità All You Can Eat.
    /// </summary>
    private decimal OrderItemsSubtotal =>
        orderItems.Sum(
            item => item.Plate.Price * item.Quantity);

    /// <summary>
    /// Il coperto viene calcolato per persona indipendentemente dalla
    /// modalità normale o All You Can Eat.
    /// </summary>
    private decimal OrderCoverAmount =>
        PeopleCount * CoverChargePerPerson;

    /// <summary>
    /// Importo All You Can Eat calcolato per persona.
    /// Se la modalità non è attiva, l'importo è zero.
    /// </summary>
    private decimal OrderAllYouCanEatAmount =>
        isAllYouCanEat
            ? PeopleCount * AllYouCanEatPricePerPerson
            : 0m;

    /// <summary>
    /// Calcola il totale applicando la regola economica dell'ordine.
    ///
    /// Modalità standard:
    ///     piatti + coperto.
    ///
    /// Modalità All You Can Eat:
    ///     quota AYCE per persona + coperto.
    ///
    /// In modalità AYCE i prezzi dei singoli piatti non concorrono al totale.
    /// </summary>
    private decimal OrderTotal =>
        isAllYouCanEat
            ? OrderAllYouCanEatAmount + OrderCoverAmount
            : OrderItemsSubtotal + OrderCoverAmount;

    private bool CanPlaceOrder =>
        orderItems.Count > 0
        && HasValidReservation;

    private string CoverSummaryLabel =>
        $"Coperto ({PeopleCount} × {FormatPrice(CoverChargePerPerson)})";

    private string AllYouCanEatSummaryLabel =>
        $"All You Can Eat ({PeopleCount} × {FormatPrice(AllYouCanEatPricePerPerson)})";

    /// <summary>
    /// Fornisce alla UI la motivazione per cui il pulsante "Ordina"
    /// è disabilitato. Le condizioni seguono lo stesso ordine logico
    /// utilizzato per stabilire se l'ordine può essere inviato.
    /// </summary>
    private string PlaceOrderButtonTitle
    {
        get
        {
            if (!HasValidReservation)
            {
                return "Configura tavolo e numero di persone prima di ordinare.";
            }

            if (orderItems.Count == 0)
            {
                return "Aggiungi almeno un piatto all'ordine.";
            }

            return "Invia l'ordine alla cucina.";
        }
    }

    private void OpenOrder()
    {
        isOrderOpen = true;
    }

    private void CloseOrder()
    {
        isOrderOpen = false;
    }

    /// <summary>
    /// Aggiunge un piatto all'ordine.
    /// Se il piatto è già presente viene incrementata la quantità della
    /// riga esistente, evitando di creare righe duplicate per lo stesso piatto.
    /// </summary>
    private void AddToOrder(Plate plate)
    {
        var existingItem = orderItems.FirstOrDefault(
            item => item.Plate.Id == plate.Id);

        if (existingItem is null)
        {
            orderItems.Add(new OrderItem
            {
                Plate = plate,
                Quantity = 1
            });

            SyncOrderState();
            return;
        }

        existingItem.Quantity++;
        SyncOrderState();
    }

    private void IncreaseQuantity(OrderItem item)
    {
        item.Quantity++;
        SyncOrderState();
    }

    /// <summary>
    /// Diminuisce la quantità del piatto.
    /// Quando la quantità corrente è uno, la riga viene rimossa
    /// completamente dall'ordine invece di raggiungere quantità zero.
    /// </summary>
    private void DecreaseQuantity(OrderItem item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity--;
            SyncOrderState();
            return;
        }

        orderItems.Remove(item);
        SyncOrderState();
    }

    private void OnAllYouCanEatChanged(ChangeEventArgs eventArgs)
    {
        isAllYouCanEat =
            eventArgs.Value is bool checkedValue
            && checkedValue;

        SyncOrderState();
    }


    /// <summary>
    /// Sincronizza con l'OrderState le informazioni dell'ordine gestite
    /// direttamente dalla pagina menu.
    ///
    /// Tavolo e numero di persone non vengono modificati qui perché sono
    /// configurati nella Home e devono rimanere invariati per tutto l'iter.
    /// </summary>
    private void SyncOrderState()
    {
        var order = OrderState.Order;

        order.IsAllYouCanEat = isAllYouCanEat;
        order.Items = orderItems;

        // ItemsSubtotal viene mantenuto anche in modalità AYCE.
        // La decisione di ignorarlo nel totale viene applicata esclusivamente
        // dal calcolo di OrderTotal.
        order.ItemsSubtotal = OrderItemsSubtotal;

        order.CoverAmount = OrderCoverAmount;
        order.AllYouCanEatAmount = OrderAllYouCanEatAmount;
        order.TotalAmount = OrderTotal;
    }

    /// <summary>
    /// Prepara l'ordine corrente per il futuro invio alla cucina.
    /// L'invio viene impedito se le condizioni minime definite da
    /// CanPlaceOrder non sono soddisfatte.
    /// </summary>
    private void PlaceOrder()
    {
        if (!CanPlaceOrder)
        {
            return;
        }

        // Forziamo un'ultima sincronizzazione prima di utilizzare OrderState,
        // in modo che il futuro servizio riceva sempre lo stato corrente della UI.
        SyncOrderState();

        var currentOrder = OrderState.Order;

        /*
         * Punto di integrazione previsto per il futuro servizio di invio ordine.
         *
         * currentOrder contiene attualmente:
         *
         * - TableNumber
         * - PeopleCount
         * - IsAllYouCanEat
         * - Items
         * - ItemsSubtotal
         * - CoverAmount
         * - AllYouCanEatAmount
         * - TotalAmount
         *
         * In modalità All You Can Eat i piatti rimangono presenti nell'ordine,
         * ma il relativo ItemsSubtotal non viene utilizzato per calcolare
         * TotalAmount.
         */
    }

    /// <summary>
    /// Mostra il retro della card contenente la descrizione dettagliata.
    /// </summary>
    private void ShowPlateDetails(int plateId)
    {
        flippedPlateIds.Add(plateId);
    }

    /// <summary>
    /// Riporta la card alla visualizzazione principale.
    /// </summary>
    private void HidePlateDetails(int plateId)
    {
        flippedPlateIds.Remove(plateId);
    }

    /// <summary>
    /// Elenco delle categorie effettivamente presenti nei piatti caricati.
    /// Valori vuoti vengono ignorati e i duplicati vengono eliminati
    /// senza distinguere tra maiuscole e minuscole.
    /// </summary>
    private IEnumerable<string> Categories =>
        plates
            .Select(plate => plate.Category)
            .Where(category => !string.IsNullOrWhiteSpace(category))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(category => category);

    /// <summary>
    /// Piatti da visualizzare in base alla categoria selezionata.
    /// La categoria "All" non appartiene necessariamente ai dati:
    /// rappresenta il filtro speciale che mostra l'intero menu.
    /// </summary>
    private IEnumerable<Plate> FilteredPlates =>
        IsCategorySelected(AllCategory)
            ? plates
            : plates.Where(plate =>
                string.Equals(
                    plate.Category,
                    selectedCategory,
                    StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Carica il menu all'inizializzazione del componente.
    /// Eventuali errori vengono intercettati e mostrati direttamente
    /// nella sezione dedicata della pagina.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (!HasValidReservation)
        {
            shouldRedirectToHome = true;
            isLoading = false;
            return;
        }

        // Ripristina lo stato dell'ordine già presente durante
        // l'iter corrente dell'utente.
        orderItems = OrderState.Order.Items ?? [];
        isAllYouCanEat = OrderState.Order.IsAllYouCanEat;

        try
        {
            plates = await PlateService.GetPlatesAsync();
        }
        catch (Exception exception)
        {
            errorMessage = $"Impossibile caricare il menu: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Reindirizza alla Home gli accessi diretti al menu privi
    /// di una configurazione valida del tavolo.
    ///
    /// Il redirect viene eseguito dopo il primo rendering interattivo
    /// per evitare NavigationException durante il prerendering server.
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && shouldRedirectToHome)
        {
            NavigationManager.NavigateTo("/", replace: true);
        }
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
    }

    private bool IsCategorySelected(string category)
    {
        return string.Equals(
            selectedCategory,
            category,
            StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Restituisce la classe CSS della categoria aggiungendo lo stato
    /// "active" solamente all'elemento attualmente selezionato.
    /// </summary>
    private string GetCategoryClass(string category)
    {
        const string baseClass = "category-navigation__item";

        return IsCategorySelected(category)
            ? $"{baseClass} {baseClass}--active"
            : baseClass;
    }

    /// <summary>
    /// Normalizza il percorso dell'immagine del piatto.
    ///
    /// Se il percorso è già un URL "_content/" viene utilizzato così com'è;
    /// in caso contrario viene considerato relativo alla libreria Shared
    /// del progetto.
    /// </summary>
    private static string GetPlateImageUrl(string? urlImage)
    {
        if (string.IsNullOrWhiteSpace(urlImage))
        {
            return string.Empty;
        }

        var normalizedPath = urlImage
            .Replace('\\', '/')
            .TrimStart('/');

        if (normalizedPath.StartsWith(
                "_content/",
                StringComparison.OrdinalIgnoreCase))
        {
            return normalizedPath;
        }

        return $"_content/sushi-restaurant-project.Shared/{normalizedPath}";
    }

    /// <summary>
    /// Formatta gli importi utilizzando la convenzione italiana
    /// e aggiunge il simbolo dell'euro.
    /// </summary>
    private static string FormatPrice(decimal price)
    {
        return $"{price.ToString("0.00", CultureInfo.GetCultureInfo("it-IT"))} €";
    }
}